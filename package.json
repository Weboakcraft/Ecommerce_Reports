{
  "name": "ecom-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce analytics & profitability dashboard (Flipkart first) with a Google Sheets backend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
